# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Başvuru bildiriminin gideceği e-posta
MEMBERSHIP_NOTIFY_EMAIL=sihameddernek@gmail.com

# Gönderen (Resend'de doğrulanmış alan adı kullanın; test için onboarding@resend.dev)
# RESEND_FROM_EMAIL=SİHAMED <bildirim@sihamed.org.tr>
RESEND_FROM_EMAIL=SİHAMED Başvuru <onboarding@resend.dev>

# Admin paneli ( /admin )
ADMIN_USERNAME=admin
ADMIN_PASSWORD=strong-password
ADMIN_SESSION_SECRET=change-this-long-random-secret

# PostgreSQL — Docker web konteyneri için servis adı: postgres-db (localhost DEĞİL).
# Web konteyneri içinde localhost, postgres sunucusunu değil kendisini gösterir; yanlışsa
# üye sayısı okunur gibi görünür ama kayıt «Üye sayısı güncellenemedi» verir.
# Şifrede özel karakter varsa URL içinde kodlayın (ör. ! → %21).
DATABASE_URL=postgresql://admin:admin123@postgres-db:5432/sihamed2
# Yerelde npm run dev: postgresql://admin:admin123@localhost:5432/sihamed2
# Kalıcı DB yoksa veya bağlantı kurulamazsa üye sayısı /app/data/site-stats.json dosyasına yazılır (Docker).

# Bazı ortamlarda SSL zorunlu olabilir (örn: cloud postgres)
# DATABASE_SSL=true
